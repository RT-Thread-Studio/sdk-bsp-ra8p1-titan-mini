"""Keep the entry point parseable by RT-Thread Studio's Python 2 Env."""
import sys

if sys.version_info < (3, 10):
    from studio_build import launch
    DefaultEnvironment(tools=[])
    # Preserve the original working directory for options such as -C/--directory.
    Exit(launch(sys.argv[1:], cwd=GetLaunchDir()))

SConscript('SConstruct.py')
