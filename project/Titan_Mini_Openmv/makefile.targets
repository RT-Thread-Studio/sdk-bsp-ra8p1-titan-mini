.PHONY: openmv-all openmv-package clean2

openmv-all:
	$(OPENMV_PYTHON) -E -B -u ../tools/native_build.py prepare
	+$(MAKE) --no-print-directory all

all: openmv-package

openmv-package: rtthread.elf
	$(OPENMV_PYTHON) -E -B ../tools/native_build.py package --build-dir .

rtthread.elf: ../board/linker_scripts/fsp.ld ../build/generated/vision_sections.ld

clean2:
	$(OPENMV_PYTHON) -E -B ../tools/native_build.py clean --build-dir .
